# Copy this file to `.env` and fill in real values for your environment.

# Drizzle / @libsql/client — local SQLite file (use file: prefix).
# For Postgres later: "postgresql://user:pass@host:5432/db"
DATABASE_URL="file:db/excalidraw.db"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"

# Storage factory driver: "local" (default) | future: "s3" | "blob"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/drawings"
